<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#4D94DB"
    tools:context=".Signup">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Signup"
        android:textSize="38sp"
        android:textAlignment="center"
        android:textStyle="bold|italic"
        android:background="@drawable/shape"
        android:padding="12dp"
        android:fontFamily="cursive"
        android:textColor="#eee8e3"/>

<!--    below is a card view-->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="10dp"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

<!--            Below is the edittext for username-->
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="👤  Enter Your Username"
                android:textColorHint="#000"
                android:backgroundTint="#eee8e3"
                android:id="@+id/username"
                android:textColor="#000"
                android:layout_margin="8dp"
                android:background="#9B7985"
                android:textSize="22sp"
                android:padding="10dp"/>

            <!--            Below is the edittext for email-->
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="📧  Enter Your Email Address"
                android:textColorHint="#000"
                android:backgroundTint="#eee8e3"
                android:id="@+id/email"
                android:inputType="textEmailAddress"
                android:textColor="#000"
                android:layout_margin="8dp"
                android:background="#9B7985"
                android:textSize="22sp"
                android:padding="10dp"/>

            <!--            Below is the edittext for password-->
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="🔑  Enter Your Password"
                android:textColorHint="#000"
                android:backgroundTint="#eee8e3"
                android:id="@+id/password"
                android:inputType="textPassword"
                android:textColor="#000"
                android:layout_margin="8dp"
                android:background="#9B7985"
                android:textSize="22sp"
                android:padding="10dp"/>

            <!--            Below is the edittext for phone number-->
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="📞 Enter Your Phone Number"
                android:textColorHint="#000"
                android:backgroundTint="#eee8e3"
                android:id="@+id/Phone"
                android:inputType="number"
                android:textColor="#000"
                android:layout_margin="8dp"
                android:background="#9B7985"
                android:textSize="22sp"
                android:padding="10dp"/>

<!--            below is a signup button with its properties-->
            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👤 Signup"
                android:textSize="25sp"
                android:padding="10dp"
                android:layout_marginTop="25dp"
                android:layout_margin="8dp"
                android:textColor="#020307"
                android:backgroundTint="#765"
                android:id="@+id/signupBtn"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Already Have an Accout? Signin"
                android:textAlignment="center"
                android:textSize="23sp"
                android:layout_marginTop="25dp"
                android:textColor="#0013e9"
                android:id="@+id/signintxt" />


        </LinearLayout>

    </androidx.cardview.widget.CardView>



</LinearLayout>