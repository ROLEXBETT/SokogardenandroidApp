<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#140783"
    tools:context=".About">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="About Us"
        android:textStyle="bold"
        android:textSize="42sp"
        android:textColor="#fff"
        android:textAlignment="center" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        app:cardElevation="15dp"
        app:cardCornerRadius="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#C2D1EF"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/aboutTxt"
                android:text="Welcome to our Ecommerce application, a simple user friendly platform designed to make online shopping easy and accessible for everyone. Users can quickly create accounts, securely log in and browse a wide range of products with detailed description and the product photos. Our seamless checkout process allows customers to pay conveniently by use of Mpesa. We look forward to doing business with you."
                android:textSize="22sp"
                android:textColor="#000"
                android:textAlignment="center"/>

            <Button
                android:id="@+id/btnListen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Listen to About Us"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:backgroundTint="#140783"
                android:textColor="#fff"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>